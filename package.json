{
  "name": "archivist-monorepo",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "fmt": "turbo run fmt",
    "dev:backend": "cargo run --manifest-path apps/backend/Cargo.toml --bin record",
    "dev:frontend": "cd apps/frontend && bun run dev --port 3001",
    "check:backend:dev": "bash scripts/dev/check-backend.sh",
    "release:preflight": "bash scripts/release/preflight-check.sh",
    "release:smoke": "bash scripts/release/smoke-test.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
