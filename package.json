{
  "name": "archivist-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "fmt": "turbo run fmt",
    "release:preflight": "bash scripts/release/preflight-check.sh",
    "release:smoke": "bash scripts/release/smoke-test.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
