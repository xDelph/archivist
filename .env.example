# Arkivist v2 workspace environment template

# Shared Postgres configuration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Shared queue and storage providers.
UPSTASH_QSTASH_URL=
UPSTASH_QSTASH_TOKEN=
UPSTASH_QSTASH_CURRENT_SIGNING_KEY=
UPSTASH_QSTASH_NEXT_SIGNING_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_ENDPOINT_URL=
ARKIVIST_R2_KEY_PREFIX=

# Slack ingest and auth.
SLACK_SIGNING_SECRET=
SLACK_API_BASE_URL=https://slack.com/api
SLACK_USER_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# apps/api
ARKIVIST_API_HOST=127.0.0.1
ARKIVIST_API_PORT=4000
ARKIVIST_WEB_ORIGIN=http://127.0.0.1:3001
ARKIVIST_SESSION_SECRET=
ARKIVIST_AUTH_STORE_PATH=logs/auth-identities.json
ARKIVIST_SYNCED_USERS_PATH=logs/synced-users.json

# apps/ingest
ARKIVIST_INGEST_HOST=127.0.0.1
ARKIVIST_INGEST_PORT=4001
ARKIVIST_WORKER_BASE_URL=http://127.0.0.1:4002

# apps/worker
ARKIVIST_WORKER_HOST=127.0.0.1
ARKIVIST_WORKER_PORT=4002
ARKIVIST_EVENT_LOG_PATH=logs/process-events.jsonl
ARKIVIST_AI_SUMMARIES_ENABLED="false"

# apps/frontend
VITE_API_BASE_URL=http://127.0.0.1:4000
