# =========================================
# Archivist monorepo environment template
# =========================================

# ---------- Shared / backend ----------

# Primary pooled Postgres URL (required)
DATABASE_URL=

# Direct non-pooled Postgres URL (required for some maintenance jobs)
DATABASE_URL_UNPOOLED=

# Slack app secrets (required for Events API ingest)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Optional fallback if a user token is used for backfill tooling
SLACK_USER_TOKEN=

# Workspace URL shown in UI (example: my-workspace.slack.com)
SLACK_WORKSPACE_URL=

# Admin endpoint auth token (required for /api/admin/backfill)
ADMIN_TOKEN=

# ---------- File archive storage (required if using file archival) ----------

CLOUDFLARED_R2_ACCOUNT_ID=
CLOUDFLARED_R2_ACCESS_KEY=
CLOUDFLARED_R2_SECRET_KEY=
CLOUDFLARED_R2_BUCKET=
CLOUDFLARED_R2_PUBLIC_URL=

# Optional helper token for maintenance tooling
CLOUDFLARED_R2_TOKEN=

# ---------- Frontend ----------

# Backend API base URL for frontend app.
# Keep empty for same-origin deployment, or set full URL for split frontend/backend projects.
NEXT_PUBLIC_API_BASE_URL=

# Backend API base URL used by frontend server routes/BFF (recommended explicit value)
BACKEND_API_BASE_URL=

# Shared secret used by frontend BFF to authenticate with backend APIs
FRONTEND_BACKEND_SHARED_SECRET=

# ---------- Auth security ----------

# 32-byte key for email encryption at rest (raw or base64/base64url)
EMAIL_ENCRYPTION_KEY=

# Key for deterministic email lookup hash (HMAC-SHA256)
EMAIL_LOOKUP_KEY=

# Optional pepper appended before password hashing
PASSWORD_PEPPER=

# Dev-only helper for reset password flow (do not enable in production)
AUTH_DEV_EXPOSE_RESET_TOKEN=false

# ---------- CI / GitHub Actions ----------

# GitHub Action secret used by backfill cron.
# Should point to backend deployment URL (example: https://archivist-backend.vercel.app)
APP_URL=
