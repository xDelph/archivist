# Copy this file to .env before running `docker compose up`.
# These defaults are for the Compose stack, not for direct host execution.

ARKIVIST_FRONTEND_PORT=3001
ARKIVIST_WEB_ORIGIN=http://localhost:3001
SLACK_REDIRECT_URI=http://localhost:3001/api/auth/slack/callback

DATABASE_URL=postgresql://user:password@db-host:5432/archivist
DATABASE_URL_UNPOOLED=

ARKIVIST_SESSION_SECRET=replace-with-a-long-random-secret
ARKIVIST_SLACK_COMMAND_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_API_BASE_URL=https://slack.com/api
SLACK_USER_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
SLACK_OIDC_TOKEN_URL=

UPSTASH_QSTASH_URL=
UPSTASH_QSTASH_TOKEN=
UPSTASH_QSTASH_CURRENT_SIGNING_KEY=
UPSTASH_QSTASH_NEXT_SIGNING_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_ENDPOINT_URL=
ARKIVIST_R2_KEY_PREFIX=
