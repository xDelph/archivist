{
  "name": "@archivist/worker",
  "private": true,
  "scripts": {
    "dev": "cargo run --manifest-path ../../Cargo.toml -p worker",
    "build": "cargo build --manifest-path ../../Cargo.toml -p worker",
    "lint": "cargo clippy --manifest-path ../../Cargo.toml -p worker --all-targets -- -D warnings",
    "test": "cargo test --manifest-path ../../Cargo.toml -p worker",
    "check": "cargo check --manifest-path ../../Cargo.toml -p worker",
    "fmt": "cargo fmt --manifest-path ../../Cargo.toml -p worker --check",
    "typecheck": "cargo check --manifest-path ../../Cargo.toml -p worker"
  }
}
