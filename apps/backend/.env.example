DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_TOKEN=xoxp-your-user-token
ADMIN_TOKEN=your_admin_token
UPSTASH_QSTASH_TOKEN=your_qstash_token
UPSTASH_QSTASH_URL=https://qstash.upstash.io
UPSTASH_QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key
UPSTASH_QSTASH_NEXT_SIGNING_KEY=your_next_signing_key
BACKFILL_WORKER_TOKEN=your_backfill_worker_token
