# BACKFILL_WORKER_URL=
# Optional tuning
# QSTASH_TIMEOUT_SECONDS=10
# AGGREGATION_JOBS_PER_BATCH=200
# AGGREGATION_MAX_BATCHES_PER_RUN=200
CLOUDFLARED_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARED_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARED_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARED_R2_BUCKET=archivist-files
CLOUDFLARED_R2_PUBLIC_URL=https://pub-xxx.r2.dev
RUST_LOG=info
